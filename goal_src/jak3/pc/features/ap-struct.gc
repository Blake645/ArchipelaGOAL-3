;;-*-Lisp-*-
(in-package goal)

(define-extern ap-messenger-reset! (function none))
(define-extern *ap-reverse-controls?* symbol)
(define-extern ap-deathlink-vehicle-check! (function symbol))
(declare-type turret-info basic)
(declare-type was-pre-game process-drawable)
(define-extern *was-pre-game* (pointer was-pre-game))
(declare-type power-game process-drawable)
(define-extern *power-game* (pointer power-game))

(define *ap-info-jak3* (new 'static 'ap-info-jak3))
(pc-get-archipelago-struct)

;; Initialize connection status to default (0)
(set! (-> *ap-info-jak3* connection-status) (ap-connection-status default))

;; Setup markers
(charp<-string (-> *ap-info-jak3* end-marker) "end")

;; ****************************************************************************
;; **** This number must match expected_memory_version in MemoryReader.py! ****
;; ****************************************************************************
(set! (-> *ap-info-jak3* version) 6)

;; <ap:preserve-this> autosave timer for preventing progress loss on life resets
(define *ap-autosave-timer* (the time-frame 0))

;; <ap:preserve-this> guard flag to prevent multiple simultaneous saves
(define *ap-auto-saving?* #f)

;; <ap:preserve-this> auto save function using the official save mechanism
(defun ap-auto-save! ()
  (when (not *ap-auto-saving?*)
    (process-spawn-function process
      (lambda :behavior process ()
        (true! *ap-auto-saving?*)
        (auto-save-command 'auto-save 0 0 *default-pool* #f)
        (suspend-for (seconds 1))
        (false! *ap-auto-saving?*))))
  *ap-auto-saving?*)

;; <ap:preserve-this> queue for important-item talker announcements, so multiple items received
;; at the same time don't have their announcement text overwrite each other. Each talker entry
;; has its own delay+text-duration (e.g. 3s delay + 5s display), so we cooldown between spawns
;; rather than firing the instant the previous one is no longer "displayed".
(define *ap-important-item-queue* '())
(define *ap-talker-cooldown-timer* (the time-frame 0))

(defun list-append! ((lst pair) (item string))
  (if (null? lst)
      (cons item '())
      (let ((cur lst))
        (while (not (null? (cdr cur)))
          (set! cur (the-as pair (cdr cur)))
          )
        (set! (-> cur cdr) (cons item '()))
        lst
        )
      )
  )

(defun queue-important-talker! ((speech-name string))
  (set! *ap-important-item-queue*
        (if (null? *ap-important-item-queue*)
            (cons speech-name '())
            (list-append! (the-as pair *ap-important-item-queue*) speech-name)
            )
        )
  (none)
  )
  
;; <ap:preserve-this> force-clear ctywide's borrow slot 4, to prevent multiple slot-4-dependent
;; missions from being loaded simultaneously due to AP's non-linear unlock order (root cause of
;; "could not find free borrow bank" crash).
(defun ap-clear-ctywide-borrow-slot-4! ()
  (let ((ctywide-info (lookup-level-info 'ctywide)))
    (when ctywide-info
      (set! (-> ctywide-info borrow borrow-info 4) #f)
      (set! (-> ctywide-info borrow borrow-size 4) (the-as uint16 0))
      )
    )
  (none)
  )
(defun ap-mission-checked! ((mission-id uint))
  (format 0 "~%~%*************************************************~%")
  (format 0 "*** ARCHIPELAGO MISSION COMPLETION DETECTED ***~%")
  (format 0 "*************************************************~%")
  (format 0 "Mission ID: ~D~%" mission-id)
  (format 0 "Index in array: ~D~%" (-> *ap-info-jak3* next-mission-index))
  (format 0 "Total missions tracked: ~D~%" (+ (-> *ap-info-jak3* next-mission-index) 1))
  (format 0 "*************************************************~%~%")
  (set! (-> *ap-info-jak3* missions-checked (-> *ap-info-jak3* next-mission-index)) mission-id)
  (+! (-> *ap-info-jak3* next-mission-index) 1))

(defun ap-side-mission-checked! ((side-mission-id uint))
  (format 0 "~%~%**************************************************~%")
  (format 0 "*** ARCHIPELAGO SIDE MISSION COMPLETION DETECTED ***~%")
  (format 0 "**************************************************~%")
  (format 0 "Side Mission ID: ~D~%" side-mission-id)
  (format 0 "Index in array: ~D~%" (-> *ap-info-jak3* next-side-mission-index))
  (format 0 "Total side missions tracked: ~D~%" (+ (-> *ap-info-jak3* next-side-mission-index) 1))
  (format 0 "**************************************************~%~%")
  (set! (-> *ap-info-jak3* side-missions-checked (-> *ap-info-jak3* next-side-mission-index)) side-mission-id)
  (+! (-> *ap-info-jak3* next-side-mission-index) 1))

(defun ap-set-connection-status! ((status ap-connection-status))
  "Set the Archipelago connection status. Returns the status that was set."
  (set! (-> *ap-info-jak3* connection-status) status)
  status)

(defun ap-draw-connection-status ()
  "Draw the current Archipelago connection status on screen every frame"
  (when (and *ap-info-jak3* *common-text*)
    (case (-> *ap-info-jak3* connection-status)
      (((ap-connection-status default))
       (format *stdcon* "~%~4LArchipelaGOAL: Not Connected...~0L~%"))
      (((ap-connection-status wait))
       (format *stdcon* "~%~4LArchipelaGOAL: Waiting for Items...~0L~%"))
      (((ap-connection-status failure))
       (format *stdcon* "~%~4LArchipelaGOAL: Connection Failed!~0L~%"))
      ))
  (none))

;; Debug function to manually test mission completion tracking
(defun ap-debug-test-mission-completion ()
  "Test function to manually trigger mission completion debug output"
  (format 0 "~%~%===============================================~%")
  (format 0 "TESTING ARCHIPELAGO MISSION COMPLETION SYSTEM~%")
  (format 0 "===============================================~%")
  (format 0 "Current mission index: ~D~%" (-> *ap-info-jak3* next-mission-index))
  (format 0 "Current side mission index: ~D~%" (-> *ap-info-jak3* next-side-mission-index))
  (format 0 "Testing mission completion...~%")
  (ap-mission-checked! (the-as uint 1))  ;; arena-training-1
  (format 0 "Testing side mission completion...~%")
  (ap-side-mission-checked! (the-as uint 100))  ;; dummy side mission
  (format 0 "===============================================~%")
  (format 0 "TEST COMPLETE - Check output above~%")
  (format 0 "===============================================~%~%")
  (none))

;; Debug function to manually test task resolution close
(defun ap-debug-test-task-resolution ()
  "Test function to manually call task-resolution-close! to see debug output"
  (format 0 "~%~%===============================================~%")
  (format 0 "TESTING TASK-RESOLUTION-CLOSE! DIRECTLY~%")
  (format 0 "===============================================~%")
  (format 0 "Calling task-resolution-close! with arena-training-1...~%")
  (task-resolution-close! (game-task arena-training-1))
  (format 0 "===============================================~%")
  (format 0 "TEST COMPLETE - Check output above~%")
  (format 0 "===============================================~%~%")
  (none))

;; Debug function to show current task states
(defun ap-debug-show-task-states ()
  "Show current completion state of some key missions"
  (format 0 "~%~%===============================================~%")
  (format 0 "CURRENT TASK STATES~%")
  (format 0 "===============================================~%")
  (format 0 "arena-training-1 complete?: ~A~%" (task-complete? *game-info* (game-task arena-training-1)))
  (format 0 "arena-fight-1 complete?: ~A~%" (task-complete? *game-info* (game-task arena-fight-1)))
  (format 0 "wascity-chase: ~A~%" (task-complete? *game-info* (game-task wascity-chase)))
  (format 0 "Game task counter: ~D~%" (-> *game-info* task-counter))
  (format 0 "===============================================~%~%")
  (none))

;; Debug function to test connection status display
(defun ap-debug-test-connection-status ()
  "Cycle through connection status values for testing display"
  (case (-> *ap-info-jak3* connection-status)
    (((ap-connection-status default)) (ap-set-connection-status! (ap-connection-status wait)))
    (((ap-connection-status wait)) (ap-set-connection-status! (ap-connection-status failure)))
    (((ap-connection-status failure)) (ap-set-connection-status! (ap-connection-status ready)))
    (((ap-connection-status ready)) (ap-set-connection-status! (ap-connection-status default)))
    (else (ap-set-connection-status! (ap-connection-status default))))
  (format 0 "~%~%===============================================~%")
  (format 0 "ARCHIPELAGO DEBUG MODE TOGGLE~%")
  (format 0 "===============================================~%")
  (format 0 "Connection status changed to: ~D~%" (-> *ap-info-jak3* connection-status))
  (format 0 "Status meaning: ~A~%"
    (case (-> *ap-info-jak3* connection-status)
      (((ap-connection-status default)) "Connecting to Archipelago")
      (((ap-connection-status wait)) "Waiting for items from other players")
      (((ap-connection-status failure)) "Connection failed - check client")
      (((ap-connection-status ready)) "Connected and ready")
      (else "Unknown status")))
  (format 0 "===============================================~%~%")
  (none))

(defun ap-verify-game-completed! ((arg0 uint))
  (when (> (-> *ap-info-jak3* completion-goal-value) 0)
    (cond
      ((= (-> *ap-info-jak3* completion-goal-type) (ap-completion-type mission-count))
        (when (= (+ (-> *ap-info-jak3* next-mission-index)
                    (-> *ap-info-jak3* next-side-mission-index))
                 (-> *ap-info-jak3* completion-goal-value))
          (set! (-> *ap-info-jak3* completed) 1)
          (task-close! "city-win-resolution")
          )
        )
      ((= (-> *ap-info-jak3* completion-goal-type) (ap-completion-type specific-mission))
        (when (= (the-as uint arg0)
                 (-> *ap-info-jak3* completion-goal-value))
          (set! (-> *ap-info-jak3* completed) 1)
          (task-close! "city-win-resolution")
          )
        )
      )
    )
  #t
  )

