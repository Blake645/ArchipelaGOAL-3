;;-*-Lisp-*-
(in-package goal)

#| This file defines a process-taskable menu structure and its related lists.
   Each menu list corresponds to a specific cutscene, game-task-node, actor, etc,
   based on mission/task progress.

   Also, check the method `setup-fields` of the `warp-gate` type in `warp-gate-menu-data.gc`, 
   which is responsible for assigning a menu entry list to a specific entity. Do this if you
   want to add custom warp-gate menus in your own custom levels.  
 |#

(deftype taskable-menu-entry (structure)
  ((task-node     game-task-node)    ;; the game-task-node containing the introductory data for a mission (cutscenes, actors, etc).
   (event-idx     int)               ;; the index under `when-open` related to this menu item.
   (continue      string)            ;; the name of the continue point needed to load the cutscene from the event object.
   (text-id       text-id)           ;; the text-id that defines the phrase to be displayed for this menu item.
   (exclusive?    symbol)            ;; optional: if true and item is available, it will be the only menu item in the list (first come first serve).
   (allow-when    (function symbol)) ;; optional: function that must return true for this entry to become available
   (forbid-when   (function symbol)) ;; optional: function that hides this entry if it returns true, regardless of `allow-when`
   )  
  )

(defmacro static-taskable-menu-entry 
  (&key task-node
    &key event-idx
    &key continue
    &key text-id
    &key (exclusive? #f)
    &key (allow-when (lambda () #f))
    &key (forbid-when (lambda () #f))
    )
  `(new 'static 'taskable-menu-entry
     :task-node ,task-node
     :event-idx ,event-idx
     :continue ,continue
     :text-id ,text-id
     :exclusive? ,exclusive?
     :allow-when ,allow-when
     :forbid-when ,forbid-when
     )
  )

;; just an empty array. leave it at is.
;; used as a fallback when an entity doesn't have a defined menu.
(define *empty-taskable-menu-list* (new 'static 'boxed-array :type taskable-menu-entry))

(define *kleever-menu-list*
  (new 'static 'boxed-array :type taskable-menu-entry
    (static-taskable-menu-entry
      :task-node (game-task-node wascity-chase-introduction)
      :event-idx 0
      :continue "wasstada-entrance"
      :text-id (text-id progress-missions-wascity-chase)
      :allow-when (lambda ()
        (or (task-node-open? (game-task-node wascity-chase-introduction))
            (task-node-open? (game-task-node wascity-chase-resolution))
            )
        )
      :forbid-when (lambda () (task-node-closed? (game-task-node wascity-chase-resolution)))
      )
    (static-taskable-menu-entry
      :task-node (game-task-node desert-turtle-training-introduction)
      :event-idx 0
      :continue "wasdoors-city"
      :text-id (text-id progress-missions-desert-turtle-training)
      :allow-when (lambda ()
        (or (task-node-open? (game-task-node desert-turtle-training-introduction))
            (task-node-open? (game-task-node desert-turtle-training-resolution))
            )
        )
      :forbid-when (lambda () (task-node-closed? (game-task-node desert-turtle-training-resolution)))
      )
    (static-taskable-menu-entry
      :task-node (game-task-node desert-hover-introduction)
      :event-idx 0
      :continue "wasdoors-city"
      :text-id (text-id progress-missions-desert-hover)
      :allow-when (lambda ()
        (or (task-node-open? (game-task-node desert-hover-introduction))
            (task-node-open? (game-task-node desert-hover-resolution))
            )
        )
      :forbid-when (lambda () (task-node-closed? (game-task-node desert-hover-resolution)))
      )
    (static-taskable-menu-entry
      :task-node (game-task-node desert-catch-lizards-introduction)
      :event-idx 0
      :continue "wasdoors-city"
      :text-id (text-id progress-missions-desert-catch-lizards)
      :allow-when (lambda ()
        (or (task-node-open? (game-task-node desert-catch-lizards-introduction))
            (task-node-open? (game-task-node desert-catch-lizards-resolution))
            )
        )
      :forbid-when (lambda () (task-node-closed? (game-task-node desert-catch-lizards-resolution)))
      )
    (static-taskable-menu-entry
      :task-node (game-task-node wascity-gungame-introduction)
      :event-idx 0
      :continue "wascityb-gungame"
      :text-id (text-id progress-missions-wascity-gungame)
      :allow-when (lambda ()
        (or (task-node-open? (game-task-node wascity-gungame-introduction))
            (task-node-open? (game-task-node wascity-gungame-resolution))
            )
        )
      :forbid-when (lambda () (task-node-closed? (game-task-node wascity-gungame-resolution)))
      )
    (static-taskable-menu-entry
      :task-node (game-task-node desert-beast-battle-introduction)
      :event-idx 0
      :continue #f
      :text-id (text-id progress-missions-desert-beast-battle)
      :allow-when (lambda ()
        (or (task-node-open? (game-task-node desert-beast-battle-introduction))
            (task-node-open? (game-task-node desert-beast-battle-resolution))
            )
        )
      :forbid-when (lambda () (task-node-closed? (game-task-node desert-beast-battle-resolution)))
      )
  )
)
