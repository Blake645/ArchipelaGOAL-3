;;-*-Lisp-*-
(in-package goal)

(define *tm-selected* -1)
(define *tm-items-per-page* 6)

(defmethod task-select-menu ((this process-taskable))
  (let* ((menu (-> this menu-list))
          (list-length (-> menu length))
          (available-idxs (new 'static 'array int32 64))
          (available-count 0)
          (found-exclusive? #f)
          )
    (dotimes (i list-length)
      (let* ((allowed? (-> menu i allow-when))
             (forbidden? (-> menu i forbid-when)))
        (when (and (not found-exclusive?)
                   (or (not allowed?) (allowed?))
                   (or (not forbidden?) (not (forbidden?))))
          (cond
                ((-> menu i exclusive?)
                (set! available-count 0)
                (set! (-> available-idxs 0) i)
                (set! available-count 1)
                (set! found-exclusive? #t)
  )
            (else
              (set! (-> available-idxs available-count) i)
              (+! available-count 1)
              )
            )
          )
        )
      )
    (let* ((page (-> this page))
            (start-idx (* page *tm-items-per-page*))
            (end-idx (+ start-idx *tm-items-per-page*))
            (have-next-page? (< end-idx available-count))
            (have-prev-page? (> page 0))
            (items-this-page (min *tm-items-per-page* (- available-count start-idx)))
            (extra-options (cond
              ((and have-prev-page? have-next-page?) 2)
              (have-prev-page? 1)
              (have-next-page? 1)
              (else 0)))
            (total-items (+ items-this-page extra-options))
            )
      (when (not (paused?))
        (cond
          ((and (cpad-pressed? 0 up l-analog-up) (> (-> this selected) 0))
            (seekl! (-> this selected) 0 1)
            (sound-play "dmenu-move")
            )
          ((and (cpad-pressed? 0 down l-analog-down) (< (-> this selected) (+ total-items -1)))
            (seekl! (-> this selected) (+ total-items -1) 1)
            (sound-play "dmenu-move")
            )
          ((and (cpad-pressed? 0 confirm) (nonzero? available-count))
            (sound-play "menu-pick")
            (cond
              ((and have-prev-page? (= (-> this selected) items-this-page))
                (+! (-> this page) -1)
                (set! (-> this selected) 0)
                )
              ((and have-next-page? (or (and have-prev-page? (= (-> this selected) (+ items-this-page 1)))
                                       (and (not have-prev-page?) (= (-> this selected) items-this-page))))
                (+! (-> this page) 1)
                (set! (-> this selected) 0)
                )
              (else
                (set! *tm-selected* (-> available-idxs (+ start-idx (-> this selected))))
                (go execute-task)
                )
              )
            )
          )
        (let* ((font-height 30)
                (scale-sel 0.6)
                (scale-unsel 0.4)
                (font-x 36)
                (font-y (- 228 (* total-items (/ font-height 2))))
                (font-ctxt (new
                          'stack
                          'font-context
                          *font-default-matrix*
                          font-x
                          font-y
                          0.0
                          (font-color default)
                          (font-flags shadow kerning)
                          )
                        )
                )
            (set! (-> font-ctxt flags) (font-flags shadow kerning middle middle-vert large))
            (set! (-> font-ctxt width) (the float 440))
            (set! (-> font-ctxt height) (the float 50))
            (set! (-> font-ctxt scale) 1.0)
            (let ((a0-59 40))
              (set! (-> font-ctxt origin x) (the float font-x))
              (set! (-> font-ctxt origin y) (the float a0-59))
              )
            (set! (-> font-ctxt color) (font-color progress-old-yellow))
            (let ((select-text (lookup-text! *common-text* (text-id select-mission) #f)))
              (format (clear *temp-string*) select-text)
              )
            (print-game-text *temp-string* font-ctxt #f 44 (bucket-id hud-draw-hud-alpha))
            (set! (-> font-ctxt height) (the float font-height))
            (cond
              ((nonzero? available-count)
                (dotimes (i items-this-page)
                  (let ((valid-idx (-> available-idxs (+ start-idx i))))
                    (set! (-> font-ctxt origin x) (the float font-x))
                    (set! (-> font-ctxt origin y) (the float font-y))
                    (set! (-> font-ctxt scale) (if (= (-> this selected) i)
                                                  scale-sel
                                                  scale-unsel
                                                  )
                          )
                    (set! (-> font-ctxt color) (if (= (-> this selected) i)
                                                  (font-color progress-old-selected)
                                                  (font-color default)
                                                  )
                          )
                    (if found-exclusive?
                        (format (clear *temp-string*) "~Y~30L<~Z~+26H ~S" (lookup-text! *common-text* (-> menu valid-idx text-id) #f))
                        (format (clear *temp-string*) "~S" (lookup-text! *common-text* (-> menu valid-idx text-id) #f))
                        )
                    (print-game-text *temp-string* font-ctxt #f 44 (bucket-id hud-draw-hud-alpha))
                    (+! font-y font-height)
                    )
                  )
                (when have-prev-page?
                  (set! (-> font-ctxt origin x) (the float font-x))
                  (set! (-> font-ctxt origin y) (the float font-y))
                  (set! (-> font-ctxt scale) (if (= (-> this selected) items-this-page)
                                                  scale-sel
                                                  scale-unsel
                                                  )
                          )
                  (set! (-> font-ctxt color) (if (= (-> this selected) items-this-page)
                                                  (font-color progress-old-selected)
                                                  (font-color default)
                                                  )
                          )
                  (print-game-text (lookup-text! *common-text* (text-id previous-page) #f) font-ctxt #f 44 (bucket-id hud-draw-hud-alpha))
                  (+! font-y font-height)
                  )
                (when have-next-page?
                  (set! (-> font-ctxt origin x) (the float font-x))
                  (set! (-> font-ctxt origin y) (the float font-y))
                  (set! (-> font-ctxt scale) (if (= (-> this selected) (- total-items 1))
                                                  scale-sel
                                                  scale-unsel
                                                  )
                          )
                  (set! (-> font-ctxt color) (if (= (-> this selected) (- total-items 1))
                                                  (font-color progress-old-selected)
                                                  (font-color default)
                                                  )
                          )
                  (print-game-text (lookup-text! *common-text* (text-id next-page) #f) font-ctxt #f 44 (bucket-id hud-draw-hud-alpha))
                  (+! font-y font-height)
                  )
                )
              (else
                (set! (-> font-ctxt origin x) (the float font-x))
                (set! (-> font-ctxt origin y) (the float font-y))
                (set! (-> font-ctxt scale) 0.8)
                (set! (-> font-ctxt color) (font-color default))
                (print-game-text (lookup-text! *common-text* (text-id no-menu-data) #f) font-ctxt #f 44 (bucket-id hud-draw-hud-alpha))
                )
              )
            )
          )
      )
    )
  (none)
  )

(defmethod get-exact-task-event ((this process-taskable) (idx int))
  "Like get-current-task-event, but without looping over the entire game-task-node lists.
  Uses the menu-list index chosen by player to determine which game-task-event to run."
  (with-pp
    (let ((gp-0 (new 'static 'game-task-event :scene #f)))
      (let ((s5-0 #f)
            (task (-> this task)))
        (when #t
          (set! (-> task counter) (-> *game-info* task-counter))
          (set! (-> task current-node) (game-task-node none))
          (set! (-> task current-event) #f)
          (set! s5-0 #t)
          (let* ((menu (-> (-> this menu-list) idx))
                (node (-> menu task-node))
                (eidx (-> menu event-idx))
                (game-nodes (-> *game-info* sub-task-list))
                (node-info (-> game-nodes node)))
            (when (-> node-info when-open)
              (set! (-> task current-node) node)
              (set! (-> task current-event) (-> node-info when-open eidx))
              )
            )
          )
        (cond
          ((= (-> task current-node) (game-task-node none))
           (set! (-> gp-0 actor) (-> task actor))
           )
          (else
            (set! gp-0 (-> task current-event))
            (cond
              ((and (logtest? (-> gp-0 flags) (game-task-flags gatflag-00))
                    (let ((a1-2 (new 'stack-no-clear 'event-message-block)))
                      (set! (-> a1-2 from) (process->ppointer pp))
                      (set! (-> a1-2 num-params) 0)
                      (set! (-> a1-2 message) 'get-alert-level)
                      (let ((a0-11 (send-event-function *traffic-manager* a1-2)))
                        (and a0-11 (nonzero? a0-11))
                        )
                      )
                    )
               (set! (-> gp-0 action) (game-task-action hide))
               0
               )
              (else
                (set! (-> gp-0 action) (the-as game-task-action (-> gp-0 tex)))
                )
              )
            )
          )
        (if s5-0
            (logior! (-> gp-0 flags) (game-task-flags gatflag-01))
            (logclear! (-> gp-0 flags) (game-task-flags gatflag-01))
            )
        )
      gp-0
      )
    )
  )

(defmethod available-to-use? ((this process-taskable))
  (let* ((menu (-> this menu-list))
          (list-length (-> menu length))
          )
    (dotimes (i list-length)
      (let* ((allowed? (-> menu i allow-when))
             (forbidden? (-> menu i forbid-when)))
        (when (and (or (not allowed?) (allowed?))
                   (or (not forbidden?) (not (forbidden?))))
          (return #t)
          )
        )
      )
    (when (zero? list-length)
      (return #t)
      )
    )
  #f
  )

(defstate task-menu (process-taskable)
  :enter (behavior ()
    (set-setting! 'minimap 'clear 0.0 (minimap-flag minimap))
    (set-time! (-> self state-time))
    (if (available-to-use? self)
      (set! (-> self selected) 0)
      )
    )
  :exit (behavior ()
    (remove-setting! 'minimap)
    (send-event *camera* 'change-target *target*)
    (remove-setting! 'interp-time)
    (remove-setting! 'mode-name)
    )
  :trans (behavior ()
    (when (time-elapsed? (-> self state-time) (seconds 0.5))
      (task-select-menu self)
      (when (cpad-pressed? 0 triangle)
        (when (and (not (process-grab? *target* #f)) (not (real-movie?)))
          (process-release? *target*)
          )
        (go-virtual idle)
        )
      )
    )
  :code (behavior ()
    (set-setting! 'mode-name 'cam-really-fixed 0.0 0)
    (suspend)
    (until (process-grab? *target* #f)
      (suspend)
      )
    (sleep-code)
    )
  )

(defstate execute-task (process-taskable)
  :code (behavior ()
    (let ((event (get-exact-task-event self *tm-selected*))
          (cname (-> self menu-list *tm-selected* continue)))
      (when cname
        (let ((continue (get-continue-by-name *game-info* cname)))
          (set-continue! *game-info* continue #f)
          (send-event *target* 'continue continue)
          (suspend)
          ))
      (go-virtual active event)
      )
    )
  )