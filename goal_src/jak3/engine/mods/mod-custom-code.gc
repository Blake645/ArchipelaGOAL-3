          (set! (-> region-101 on-enter) 
            '(begin 
              (if (task-open? "sewer-met-hum-introduction") (want-display 'slumbset 'display) (want-display 'ctyslumb 'display))
            )
          )
        )
        )
        (let ((region (region-lookup-by-id 101)))
        (when region
          (set! (-> region on-exit) 
            '(begin 
              (if (task-open? "sewer-met-hum-introduction") (want-display 'slumbset #f) (want-display 'ctyslumb #f))
            )
          )
        )
        )
        ;; ruins
        (let ((region-1500 (region-lookup-by-id 1500)))
        (when region-1500
          (set! (-> region-1500 on-enter) 
            '(begin 
              (when (task-open? "palace-ruins-patrol-stadium") (scene-play "palace-ruins-patrol-intro"))
            )
          )
        )
        )
        (let ((region-1391 (region-lookup-by-id 1391)))
        (when region-1391
          (set! (-> region-1391 on-enter) 
            '(begin 
              (when (task-closed? "palace-ruins-patrol-stadium") (task-close! "palace-ruins-patrol-resolution")
                    (task-open? "palace-ruins-attack-introduction") (scene-play "palace-ruins-attack-intro"))
            )
          )
        )
        )
      (if *show-input-display* 
        (input-display-on)
        (input-display-off)
        )

      (when *debug-segment*
        (orb-placer-maintenance)
        )
(when (and *ap-settings* 
           (-> *ap-settings* item-messages?)
           (not (process-by-name "ap-messenger" *active-pool*)))
  (set! *ap-messenger* (the (pointer ap-messenger) (ap-messenger-run))))
    (none)
    )

    (defun runs-on-gem-pickup ()
      ;; Code here runs on any scout fly pickup

      (none)
      )

    (defun runs-on-task-close ()
    

      (none)
      )

    (defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
      (let* ((from-vent? #f))
        ;; Code here runs as soon as you pickup ANY eco

        (case eco-type
          (((pickup-type eco-yellow))      
            ;; Code here runs as soon as you pickup yellow eco

            )
          (((pickup-type eco-red))      
            ;; Code here runs as soon as you pickup red eco

            )
          (((pickup-type eco-blue))      
            ;; Code here runs as soon as you pickup blue eco

            )

          (((pickup-type eco-green))      
            ;; Code here runs as soon as you pickup big green eco 

            )
          )
        
        (when from-vent?
          ;; Code here runs only if the eco was picked up from a vent

          )
        )

      (none)
      )

    (defun runs-on-jak-spawn ()
      ;; Code here runs every time jak spawns (loading a file new game or death)   

      (none)
      )

    (defun runs-on-jak-death ((death-event symbol))
      ;; <ap:todo> deathlink will come later, leave it out for now
      #|
      (when (-> *ap-settings* deathlink?)
        (case death-event
          (('dying)
            ;; Code here runs immediately every time jak dies, before any death animation or death cutscene
          )   
          (('blackout)
            ;; Code here runs after jak dies (and any death cutscene finishes), during the blackout before he spawns
            )
          (('bot)
            (set! (-> *ap-info-jak2* cause-of-death) (the-as uint 5))
            (+! (-> *ap-info-jak2* death-count) (the-as uint 1))
          )
          (('centipede)
            (set! (-> *ap-info-jak2* cause-of-death) (the-as uint 6))
            (+! (-> *ap-info-jak2* death-count) (the-as uint 1))    
          )
          (('endlessfall)
