    ;;-*-Lisp-*-
    (in-package goal)

    ;; name: mod-custom-code.gc
    ;; name in dgo: mod-custom-code
    ;; dgos: TODO


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; What is this file for.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;

    #| This file contains function defenitions that are pre placed in the mod base,
    so if you place custom code inside of these functions, it will exectue based on
    the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
    to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
    an orb |#


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; Begin function defintions.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;
(defun set-region-data! ((id int) (event-name string) (data pair))
  (let ((region (region-lookup-by-id id)))
    (when region
      (cond
        ((string= event-name "on-enter")
          (set! (-> region on-enter) data)
          )
        ((string= event-name "on-inside")
          (set! (-> region on-inside) data)
          )
        ((string= event-name "on-exit")
          (set! (-> region on-exit) data)
          )
        (else
          (format 0 "ERROR: invalid event-name!~%")
          )
        )
      )
    )
  (none)
  )
    (defun runs-every-frame ()

       ;; Transfer important settings to ap-info struct
      (ap-settings-update)
      
      ;; Draw Archipelago connection status
      (ap-draw-connection-status)
      ;; <ap:note> comment this out/in to show to testers.
(when (and *debug-segment* *show-test-build-info*)
  (format *stdcon0* "~%~4LArchipelaGOAL 3 - Test Build~0L~%")
  (format *stdcon* "Found a bug? Send us a screenshot!~%")
  (format *stdcon0* "Toggle this text in Debug Menu > Modding Tools.~%~%")
  (format *stdcon0* "~4Lgame features:~0L ~S~%"
    (begin
      (clear *temp-string*)
      (bit-enum->string game-feature (-> *game-info* features) *temp-string*)
      *temp-string*
      )
    )
  (format *stdcon0* "~4Lgame items:~0L ~S~%"
    (begin
      (clear *temp-string*)
      (bit-enum->string game-items (-> *game-info* items) *temp-string*)
      *temp-string*
      )
    )
  (format *stdcon0* "~4Lgame vehicles:~0L ~S~%"
    (begin
      (clear *temp-string*)
      (bit-enum->string game-vehicles (-> *game-info* vehicles) *temp-string*)
      *temp-string*
      )
    )
  (format *stdcon0* "~4Lcurrent level:~0L ~S~%~4Ltask masks:~0L    ~S~%"
    (current-level-name)
    (begin
      (clear *temp-string*)
      (bit-enum->string task-mask (-> (level-get-target-inside *level*) task-mask) *temp-string*)
      *temp-string*
      )
    )
  (format *stdcon0* "~4Lcurrent tasks:~0L~%~%")
  (let ((level (level-get-target-inside *level*)))
    (when level
      (let ((lvlname (-> level info taskname))
            (subtasks (-> *game-info* sub-task-list)))
        (dotimes (i (-> subtasks length))
          (when (nonzero? i)
            (let ((subtask (-> subtasks i)))
              (when (and (= (-> subtask type) game-task-node-info)
                         (= (-> subtask level) lvlname))
                (case lvlname
                  (('city 'desert)
                    (if (game-task-node-info-method-12 subtask)
                      (format *stdcon0* "  ~17L~S~0L~%" (-> subtask name))))
                  (else
                    (cond
                      ((logtest? (-> subtask flags) (game-task-node-flag closed))
                        (format *stdcon0* "  ~15L~S~0L~%" (-> subtask name)))
                      ((game-task-node-info-method-12 subtask)
                        (format *stdcon0* "  ~17L~S~0L~%" (-> subtask name)))
                      (else
                        (format *stdcon0* "  ~19L~S~0L~%" (-> subtask name)))))))))))
      )
    )
  )
      ;; <ap:preserve-this> allows vinroom to be open when jak is near
    (let ((door (entity-by-name "vin-door-ctyinda-1")))
      (when door
        (set! (cdr (res-lump-struct door 'on-notice pair)) '(#t '(vinroom)))
      )
    )
    (let ((platform (entity-by-name "wstd-arena-plat-10")))
      (when platform
        (set! (cdr (res-lump-struct platform 'on-activate pair))  '(
        ((or (task-open? "desert-catch-lizards-introduction")  
        ;;(task-open? "wascity-chase-introduction") 
        ;;(task-open? "wascity-chase-resolution") 
        (task-open? "arena-fight-2-resolution") 
        (task-open? "arena-fight-3-introduction")) 'wait) 
        ((or (task-open? "arena-fight-2-fight")) 'wait-end)
        ((or (task-open? "arena-training-1-collect")) 'wait-show)
        (else #f))))
      )
    ;; <ap:preserve-this> allows wascity garage door to open when you have the pass for it
    (let ((wascity-garage-door-front (entity-by-name "wascity-airlock-4")))
          (when wascity-garage-door-front
            (set! (cdr (res-lump-struct wascity-garage-door-front 'on-notice pair)) '(((game-item? pass-front-gate) '(desert-game desertb)) (else #f)))
            )
    )
;; monk temple
      (let ((region-1691 (region-lookup-by-id 1691)))
        (when region-1691
          (set! (-> region-1691 on-enter) 
            '(begin 
              (when (task-closed? "temple-climb-introduction") (task-close! "temple-climb-resolution"))
              (when (task-open? "desert-glide-introduction") (scene-play "temple-climb-res")))
            )
          )
        )
        (let ((region-1528 (region-lookup-by-id 1528)))
        (when region-1528
          (set! (-> region-1528 on-enter) 
            '(begin 
              (when (task-open? "temple-climb-introduction") (scene-play "temple-climb-intro")) (want-sound wasall1 temple1 temple6))
            )
          )
        )
  ;; nest
        (let ((region-1155 (region-lookup-by-id 1155)))
        (when region-1155
          (set! (-> region-1155 on-enter) 
            '(begin 
              (when (task-closed? "nest-eggs-wall") (task-close! "nest-eggs-tunnel"))
            )
          )
        )
        )
  ;; mines
        (let ((region-1852 (region-lookup-by-id 1852)))
        (when region-1852
          (set! (-> region-1852 on-enter) 
            '(begin 
              (when (task-open? "mine-explore-introduction") (scene-play "catacombs-travel-res"))
            )
          )
        )
        )
        ;; ruins
        (let ((region-1500 (region-lookup-by-id 1500)))
        (when region-1500
          (set! (-> region-1500 on-enter) 
            '(begin 
              (when (task-open? "palace-ruins-patrol-introduction") (scene-play "palace-ruins-patrol-intro"))
            )
          )
        )
        )
        (let ((region-1391 (region-lookup-by-id 1391)))
        (when region-1391
          (set! (-> region-1391 on-enter) 
            '(begin 
              (when (task-closed? "palace-ruins-patrol-stadium") (task-close! "palace-ruins-patrol-resolution")
                    (task-open? "palace-ruins-attack-introduction") (scene-play "palace-ruins-attack-intro"))
            )
          )
        )
        )
            (when (logtest? (-> *game-info* features) (game-feature pass-port-mh))
            (awhen (process-by-ename "mhcity-dark-eco-door-1")
              (send-event it 'crack))
      )
      (if *show-input-display* 
        (input-display-on)
        (input-display-off)
        )

      (when *debug-segment*
        (orb-placer-maintenance)
        )
        
    (none)
    )

    (defun runs-on-gem-pickup ()
